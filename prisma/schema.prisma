generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String             @default("")
  name               String?
  imageUrl           String?
  monthlyIncome      Float?
  savingsGoal        Float?
  onboardingComplete Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  Records            Record[]
  RecurringExpenses  RecurringExpense[]
  CategoryBudgets    CategoryBudget[]
}

model Record {
  id                 String            @id @default(uuid())
  text               String
  amount             Float
  category           String            @default("Other")
  merchant           String?
  paymentMethod      String?
  note               String?
  date               DateTime          @default(now())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  /// Rent / SIP / EMI / recharge — not play money
  isCommitted        Boolean           @default(false)
  /// UPI / UTR / GPay transaction id when scanned from a screenshot
  upiRef             String?
  /// Stable key for duplicate UPI dumps (ref:… or amount+merchant+day)
  fingerprint        String?
  createdAt          DateTime          @default(now())

  @@index([userId])
  @@index([userId, date])
  @@index([recurringExpenseId])
  @@index([userId, upiRef])
  @@index([userId, fingerprint])
}

model RecurringExpense {
  id            String   @id @default(uuid())
  text          String
  amount        Float
  category      String   @default("Subscriptions")
  merchant      String?
  paymentMethod String?
  note          String?
  /// Day of month to charge (1–28)
  dayOfMonth    Int
  nextRunAt     DateTime
  isActive      Boolean  @default(true)
  /// Locked into the month (rent, SIP, EMI) vs play money (OTT, food)
  isCommitted   Boolean  @default(false)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  records       Record[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive, nextRunAt])
}

model CategoryBudget {
  id        String   @id @default(uuid())
  category  String
  amount    Float
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
}
